	cd /workspace/build && $(MAKE) $(MAKESILENT) -f src/clt/iaoo/CMakeFiles/iaoo.dir/build.make src/clt/iaoo/CMakeFiles/iaoo.dir/WbkStg.cpp.s
.PHONY : WbkStg.cpp.s

