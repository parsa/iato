	cd /workspace/build && $(MAKE) $(MAKESILENT) -f tst/lib/isa/CMakeFiles/t_umr.dir/build.make tst/lib/isa/CMakeFiles/t_umr.dir/t_umr.cpp.i
.PHONY : t_umr.cpp.i

t_umr.s: t_umr.cpp.s
.PHONY : t_umr.s

# target to generate assembly for a file
t_umr.cpp.s:
	cd /workspace/build && $(MAKE) $(MAKESILENT) -f tst/lib/isa/CMakeFiles/t_umr.dir/build.make tst/lib/isa/CMakeFiles/t_umr.dir/t_umr.cpp.s
.PHONY : t_umr.cpp.s

